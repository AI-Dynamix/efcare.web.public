---
import Layout from '~/layouts/PageLayout.astro';
import KiteBackground from '~/components/efcare/KiteBackground.astro';
import FloatingSideNav from '~/components/efcare/FloatingSideNav.astro';
import Hero from '~/components/efcare/Hero.astro';
import About from '~/components/efcare/About.astro';
import Technology from '~/components/efcare/Technology.astro';
import AppSection from '~/components/efcare/AppSection.astro';
import Services from '~/components/efcare/Services.astro';
import Values from '~/components/efcare/Values.astro';
import Partners from '~/components/efcare/Partners.astro';
import Contact from '~/components/efcare/Contact.astro';
import EfcareFooter from '~/components/efcare/EfcareFooter.astro';

const metadata = {
  title: 'EFCARE — Quản lý sức khỏe gia đình từ nhà đến bệnh viện',
  description: 'EFCARE là hệ sinh thái chăm sóc sức khỏe gia đình đa thế hệ, kết nối công nghệ, y tế và cộng đồng trong một nền tảng minh bạch, nhân văn và bền vững.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <!-- Use EFCARE custom nav — suppress default header/footer -->
    <header id="header" style="position:fixed;top:0;left:0;right:0;z-index:900;background:rgba(10,48,76,0.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(196,169,98,0.15);">
      <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;display:flex;justify-content:space-between;align-items:center;height:64px;">
        <a href="/" style="text-decoration:none;display:flex;align-items:center;gap:0.5rem;">
          <span style="font-family:'Montserrat',sans-serif;font-size:1.5rem;font-weight:900;color:#C4A962;letter-spacing:-0.02em;">EFCARE</span>
        </a>
        <nav style="display:flex;align-items:center;gap:2rem;" class="ef-nav-desktop">
          <a href="/" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;transition:color 0.2s;" onmouseover="this.style.color='#C4A962'" onmouseout="this.style.color='rgba(255,255,255,0.85)'">Trang chủ</a>
          <a href="/cong-nghe" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;transition:color 0.2s;" onmouseover="this.style.color='#C4A962'" onmouseout="this.style.color='rgba(255,255,255,0.85)'">Công nghệ</a>
          <a href="/bai-viet" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;transition:color 0.2s;" onmouseover="this.style.color='#C4A962'" onmouseout="this.style.color='rgba(255,255,255,0.85)'">Bài viết</a>
          <a href="/lien-he" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;transition:color 0.2s;" onmouseover="this.style.color='#C4A962'" onmouseout="this.style.color='rgba(255,255,255,0.85)'">Liên hệ</a>
          <a href="tel:0815515456" style="background:linear-gradient(135deg,#C4A962 0%,#D8C27A 100%);color:#0A304C;font-weight:700;font-family:'Montserrat',sans-serif;padding:0.5rem 1.25rem;border-radius:50px;text-decoration:none;font-size:0.875rem;transition:all 0.2s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='translateY(0)'">
            Hotline 0815 515 456
          </a>
        </nav>
      </div>
    </header>
  </Fragment>

  <!-- Kite parallax background -->
  <KiteBackground />

  <!-- Floating side navigation -->
  <FloatingSideNav />

  <!-- Main content sections -->
  <Hero />
  <About />
  <Technology />
  <AppSection />
  <Services />
  <Values />
  <Partners />
  <Contact />
  <EfcareFooter />

  <!-- Back to top button -->
  <button class="back-to-top" id="backToTop" aria-label="Lên đầu trang">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <Fragment slot="footer">
    <!-- Footer handled by EfcareFooter component above -->
  </Fragment>
</Layout>

<!-- Schema.org Organization markup -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "EFCARE",
  "legalName": "Công ty Cổ phần Tập đoàn Khoa học Sức khỏe",
  "url": "https://efcare.vn",
  "logo": "https://efcare.vn/favicon.svg",
  "description": "EFCARE là hệ sinh thái chăm sóc sức khỏe gia đình đa thế hệ, kết nối công nghệ, y tế và cộng đồng.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Tầng 6, số 10, ngõ 45 Trần Thái Thông",
    "addressLocality": "Cầu Giấy",
    "addressRegion": "Hà Nội",
    "addressCountry": "VN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+84-815-515-456",
    "contactType": "customer service",
    "availableLanguage": "Vietnamese",
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "08:00",
      "closes": "20:00"
    }
  },
  "email": "hello@efcare.vn",
  "sameAs": [
    "https://facebook.com/efcare.vn"
  ]
}
</script>

<script>
  // Section reveal on scroll
  (function () {
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    const staggerEls = document.querySelectorAll<HTMLElement>('.stagger-cards');

    const revealObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            revealObs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );

    const staggerObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            staggerObs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
    );

    revealEls.forEach((el) => revealObs.observe(el));
    staggerEls.forEach((el) => staggerObs.observe(el));
  })();

  // Back to top button
  (function () {
    const btn = document.getElementById('backToTop');
    if (!btn) return;

    window.addEventListener('scroll', () => {
      btn.classList.toggle('visible', window.scrollY > 400);
    }, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();

  // Smooth scroll for anchor links
  (function () {
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = (anchor as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  })();
</script>
