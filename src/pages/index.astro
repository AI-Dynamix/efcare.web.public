---
import Layout from '~/layouts/PageLayout.astro';
import EfcareHeader from '~/components/efcare/EfcareHeader.astro';
import KiteBackground from '~/components/efcare/KiteBackground.astro';
import FloatingSideNav from '~/components/efcare/FloatingSideNav.astro';
import Hero from '~/components/efcare/Hero.astro';
import About from '~/components/efcare/About.astro';
import Technology from '~/components/efcare/Technology.astro';
import AppSection from '~/components/efcare/AppSection.astro';
import Services from '~/components/efcare/Services.astro';
import Values from '~/components/efcare/Values.astro';
import Partners from '~/components/efcare/Partners.astro';
import Contact from '~/components/efcare/Contact.astro';
import EfcareFooter from '~/components/efcare/EfcareFooter.astro';

const metadata = {
  title: 'EFCARE — Quản lý sức khỏe gia đình từ nhà đến bệnh viện',
  description: 'EFCARE là hệ sinh thái chăm sóc sức khỏe gia đình đa thế hệ, kết nối công nghệ, y tế và cộng đồng trong một nền tảng minh bạch, nhân văn và bền vững.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <EfcareHeader currentPath="/" />
  </Fragment>

  <!-- Kite parallax background -->
  <KiteBackground />

  <!-- Floating side navigation -->
  <FloatingSideNav />

  <!-- Main content sections -->
  <Hero />
  <About />
  <Technology />
  <AppSection />
  <Services />
  <Values />
  <Partners />
  <Contact />
  <EfcareFooter />

  <!-- Back to top button -->
  <button class="back-to-top" id="backToTop" aria-label="Lên đầu trang">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <Fragment slot="footer">
    <!-- Footer handled by EfcareFooter component above -->
  </Fragment>
</Layout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "EFCARE",
  "legalName": "EFCARE HEALTH SCIENCE GROUP JOINT STOCK COMPANY",
  "alternateName": "Công ty Cổ phần Tập đoàn Khoa học Sức khỏe EFCARE",
  "taxID": "0111331180",
  "url": "https://efcare.vn",
  "logo": "https://efcare.vn/favicon.svg",
  "description": "EFCARE là hệ sinh thái chăm sóc sức khỏe gia đình đa thế hệ, kết nối công nghệ, y tế và cộng đồng.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Tầng 6, Số 10 Ngõ 45 Trần Thái Tông",
    "addressLocality": "Cầu Giấy",
    "addressRegion": "Hà Nội",
    "addressCountry": "VN",
    "postalCode": ""
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+84-815-515-456",
    "contactType": "customer service",
    "availableLanguage": "Vietnamese",
    "hoursAvailable": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "08:00",
      "closes": "20:00"
    }
  },
  "email": "hello@efcare.vn",
  "sameAs": [
    "https://facebook.com/efcare.vn"
  ]
}
</script>

<script>
  // Section reveal on scroll
  (function () {
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    const staggerEls = document.querySelectorAll<HTMLElement>('.stagger-cards');

    const revealObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            revealObs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );

    const staggerObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            staggerObs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
    );

    revealEls.forEach((el) => revealObs.observe(el));
    staggerEls.forEach((el) => staggerObs.observe(el));

    // Section scale effect (mockup: section:not(.in-view) scale(.985))
    const sectionObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('in-view', entry.isIntersecting);
        });
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll<HTMLElement>('.ef-section').forEach((s) => sectionObs.observe(s));
  })();

  // Back to top button
  (function () {
    const btn = document.getElementById('backToTop');
    if (!btn) return;

    window.addEventListener('scroll', () => {
      btn.classList.toggle('visible', window.scrollY > 400);
    }, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();

  // Smooth scroll for anchor links
  (function () {
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = (anchor as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  })();
</script>
