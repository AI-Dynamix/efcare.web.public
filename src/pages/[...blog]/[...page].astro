---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import EfcareHeader from '~/components/efcare/EfcareHeader.astro';
import EfcareFooter from '~/components/efcare/EfcareFooter.astro';
import AmbientRibbons from '~/components/efcare/AmbientRibbons.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Bài viết EFCARE${currentPage > 1 ? ` — Trang ${currentPage}` : ''}`,
  description:
    'Tin tức, nghiên cứu và kiến thức y tế từ đội ngũ chuyên gia EFCARE — AI Healthcare, Silver Economy, Longevity Care và xu hướng sức khỏe mới nhất.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <Fragment slot="header">
    <EfcareHeader currentPath="/bai-viet" />
  </Fragment>

  <section class="ef-blog-index">
    <AmbientRibbons />
    <div class="ef-blog-index-inner">
      <Headline
        subtitle="Tin tức, nghiên cứu và kiến thức y tế từ đội ngũ chuyên gia EFCARE — AI Healthcare, Silver Economy, Longevity Care và các xu hướng sức khỏe mới nhất."
      >
        Bài viết EFCARE
      </Headline>
      <BlogList posts={page.data} />
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
      <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
    </div>
  </section>

  <Fragment slot="footer">
    <EfcareFooter />
  </Fragment>
</Layout>

<style>
  .ef-blog-index {
    position: relative;
    overflow: hidden;
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(96px, 12vw, 132px) 1rem clamp(3rem, 7vw, 5rem);
  }

  .ef-blog-index-inner {
    position: relative;
    z-index: 1;
  }
</style>
