---
import Layout from '~/layouts/PageLayout.astro';
import EfcareFooter from '~/components/efcare/EfcareFooter.astro';
import KiteBackground from '~/components/efcare/KiteBackground.astro';

const metadata = {
  title: 'Công nghệ EFCARE — Hạ tầng y tế số tiên tiến',
  description: 'Khám phá hạ tầng công nghệ EFCARE: Healthcare AI Cloud, Medical Data Platform, IoT Healthcare và Telemedicine API — nền tảng y tế số cho Việt Nam.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header id="header" style="position:fixed;top:0;left:0;right:0;z-index:900;background:rgba(10,48,76,0.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(196,169,98,0.15);">
      <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;display:flex;justify-content:space-between;align-items:center;height:64px;">
        <a href="/" style="text-decoration:none;">
          <span style="font-family:'Montserrat',sans-serif;font-size:1.5rem;font-weight:900;color:#C4A962;letter-spacing:-0.02em;">EFCARE</span>
        </a>
        <nav style="display:flex;align-items:center;gap:2rem;">
          <a href="/" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;">Trang chủ</a>
          <a href="/cong-nghe" style="color:#C4A962;text-decoration:none;font-size:0.9375rem;font-weight:700;">Công nghệ</a>
          <a href="/bai-viet" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;">Bài viết</a>
          <a href="/lien-he" style="color:rgba(255,255,255,0.85);text-decoration:none;font-size:0.9375rem;font-weight:500;">Liên hệ</a>
          <a href="tel:0815515456" style="background:linear-gradient(135deg,#C4A962 0%,#D8C27A 100%);color:#0A304C;font-weight:700;font-family:'Montserrat',sans-serif;padding:0.5rem 1.25rem;border-radius:50px;text-decoration:none;font-size:0.875rem;">
            Hotline 0815 515 456
          </a>
        </nav>
      </div>
    </header>
  </Fragment>

  <KiteBackground />

  <!-- Page Hero -->
  <section style="background:linear-gradient(135deg,#0A304C 0%,#084F8A 100%);padding:8rem 1.5rem 5rem;text-align:center;position:relative;z-index:1;">
    <span class="section-tag">Công nghệ</span>
    <h1 style="font-family:'Montserrat',sans-serif;font-size:clamp(2rem,5vw,3rem);font-weight:900;color:#ffffff;margin:1rem 0;line-height:1.2;">
      Hạ tầng công nghệ<br/><span style="color:#C4A962;">chăm sóc sức khỏe</span>
    </h1>
    <p style="color:rgba(255,255,255,0.75);font-size:1.125rem;max-width:600px;margin:0 auto 2rem;line-height:1.7;">
      EFCARE xây dựng nền tảng công nghệ y tế tiên tiến nhất Việt Nam, kết hợp AI, IoT và Cloud để mang lại dịch vụ chăm sóc sức khỏe toàn diện.
    </p>
  </section>

  <!-- Tech Cards Section -->
  <section style="background:var(--ivory);padding:5rem 1.5rem;position:relative;z-index:1;">
    <div class="max-container">
      <div class="section-header reveal">
        <span class="section-tag">Hệ thống</span>
        <h2 class="section-title">Bốn trụ cột công nghệ</h2>
        <p class="section-subtitle">Mỗi trụ cột đóng vai trò quan trọng trong hệ sinh thái y tế số của EFCARE.</p>
      </div>

      <div class="services-grid stagger-cards" style="gap:2rem;">
        <!-- Healthcare AI Cloud -->
        <div class="ivory-card">
          <div style="background:linear-gradient(135deg,#0A304C,#084F8A);border-radius:1rem;padding:1.5rem;margin-bottom:1.5rem;">
            <div class="card-icon" style="margin-bottom:0.75rem;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3 style="font-family:'Montserrat',sans-serif;font-weight:700;color:#C4A962;font-size:1.25rem;">Healthcare AI Cloud</h3>
          </div>
          <p style="color:#4a5568;line-height:1.7;margin-bottom:1rem;">
            Hạ tầng điện toán đám mây chuyên biệt cho y tế, tích hợp trí tuệ nhân tạo để phân tích dữ liệu sức khỏe theo thời gian thực. Tuân thủ tiêu chuẩn HIPAA và ISO 27001.
          </p>
          <ul class="card-list" style="--gold:#C4A962;">
            <li style="color:#4a5568;">Lưu trữ phân tán, bảo mật cao</li>
            <li style="color:#4a5568;">AI phân tích hình ảnh y tế (X-quang, MRI, CT)</li>
            <li style="color:#4a5568;">Natural Language Processing cho hồ sơ bệnh án</li>
            <li style="color:#4a5568;">Predictive analytics dự báo nguy cơ bệnh</li>
            <li style="color:#4a5568;">API tích hợp với HIS/EMR bệnh viện</li>
          </ul>
        </div>

        <!-- Medical Data Platform -->
        <div class="ivory-card">
          <div style="background:linear-gradient(135deg,#1a6b4a,#228a5e);border-radius:1rem;padding:1.5rem;margin-bottom:1.5rem;">
            <div class="card-icon" style="margin-bottom:0.75rem;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            </div>
            <h3 style="font-family:'Montserrat',sans-serif;font-weight:700;color:#C4A962;font-size:1.25rem;">Medical Data Platform</h3>
          </div>
          <p style="color:#4a5568;line-height:1.7;margin-bottom:1rem;">
            Nền tảng quản lý dữ liệu y tế thống nhất, cho phép chia sẻ thông tin an toàn giữa bệnh nhân, bác sĩ và cơ sở y tế. Hỗ trợ chuẩn HL7 FHIR quốc tế.
          </p>
          <ul class="card-list" style="--gold:#C4A962;">
            <li style="color:#4a5568;">Hồ sơ bệnh án điện tử toàn diện</li>
            <li style="color:#4a5568;">Chuẩn HL7 FHIR R4 quốc tế</li>
            <li style="color:#4a5568;">Chia sẻ dữ liệu có kiểm soát</li>
            <li style="color:#4a5568;">Phân tích dữ liệu dân số y tế</li>
            <li style="color:#4a5568;">Tuân thủ Nghị định 13/2023/NĐ-CP</li>
          </ul>
        </div>

        <!-- IoT Healthcare -->
        <div class="ivory-card">
          <div style="background:linear-gradient(135deg,#7b3f00,#a35200);border-radius:1rem;padding:1.5rem;margin-bottom:1.5rem;">
            <div class="card-icon" style="margin-bottom:0.75rem;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <h3 style="font-family:'Montserrat',sans-serif;font-weight:700;color:#C4A962;font-size:1.25rem;">IoT Healthcare</h3>
          </div>
          <p style="color:#4a5568;line-height:1.7;margin-bottom:1rem;">
            Hệ thống kết nối thiết bị y tế thông minh — từ đồng hồ đo nhịp tim, máy đo huyết áp đến thiết bị theo dõi đường huyết — gửi dữ liệu tức thì về nền tảng.
          </p>
          <ul class="card-list" style="--gold:#C4A962;">
            <li style="color:#4a5568;">Kết nối 500+ loại thiết bị y tế</li>
            <li style="color:#4a5568;">Truyền dữ liệu real-time qua Bluetooth/WiFi</li>
            <li style="color:#4a5568;">Cảnh báo bất thường tức thì</li>
            <li style="color:#4a5568;">Tích hợp wearable devices</li>
            <li style="color:#4a5568;">Giao thức bảo mật MQTT/TLS</li>
          </ul>
        </div>

        <!-- Telemedicine API -->
        <div class="ivory-card">
          <div style="background:linear-gradient(135deg,#5b2d8e,#7b3db5);border-radius:1rem;padding:1.5rem;margin-bottom:1.5rem;">
            <div class="card-icon" style="margin-bottom:0.75rem;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <h3 style="font-family:'Montserrat',sans-serif;font-weight:700;color:#C4A962;font-size:1.25rem;">Telemedicine API</h3>
          </div>
          <p style="color:#4a5568;line-height:1.7;margin-bottom:1rem;">
            Bộ API telemedicine cho phép bệnh viện, phòng khám và ứng dụng y tế tích hợp khả năng tư vấn trực tuyến, video call và kê đơn điện tử vào hệ thống hiện có.
          </p>
          <ul class="card-list" style="--gold:#C4A962;">
            <li style="color:#4a5568;">Video consultation API HD</li>
            <li style="color:#4a5568;">E-prescription chuẩn Bộ Y tế</li>
            <li style="color:#4a5568;">Đặt lịch & quản lý hàng đợi</li>
            <li style="color:#4a5568;">Thanh toán tích hợp VNPay/MoMo</li>
            <li style="color:#4a5568;">SDK cho iOS, Android, Web</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section style="background:linear-gradient(135deg,#0A304C 0%,#071f33 100%);padding:4rem 1.5rem;text-align:center;position:relative;z-index:1;">
    <div class="max-container reveal">
      <span class="section-tag">Hợp tác</span>
      <h2 style="font-family:'Montserrat',sans-serif;font-size:2rem;font-weight:900;color:#ffffff;margin:1rem 0;">
        Sẵn sàng tích hợp công nghệ EFCARE?
      </h2>
      <p style="color:rgba(255,255,255,0.7);font-size:1.0625rem;max-width:500px;margin:0 auto 2rem;line-height:1.7;">
        Liên hệ đội ngũ kỹ thuật của chúng tôi để được tư vấn giải pháp tích hợp phù hợp.
      </p>
      <a href="/lien-he" class="btn-primary-ef" style="display:inline-flex;">
        Liên hệ tư vấn kỹ thuật
      </a>
    </div>
  </section>

  <EfcareFooter />

  <Fragment slot="footer">
    <!-- Handled by EfcareFooter -->
  </Fragment>
</Layout>

<script>
  // Section reveal animations
  document.querySelectorAll('.reveal').forEach((el) => {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    obs.observe(el);
  });

  document.querySelectorAll('.stagger-cards').forEach((el) => {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05 }
    );
    obs.observe(el);
  });
</script>
