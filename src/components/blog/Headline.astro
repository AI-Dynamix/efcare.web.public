---
const { title = await Astro.slots.render('default'), subtitle = await Astro.slots.render('subtitle') } = Astro.props;
---

<header class="ef-blog-headline">
  <span class="ef-blog-kicker">EFCARE Insights</span>
  <h1 set:html={title} />
  {subtitle && <div class="ef-blog-subtitle" set:html={subtitle} />}
</header>

<style>
.ef-blog-headline {
  max-width: 760px;
  margin: 0 auto clamp(2rem, 5vw, 3.5rem);
  text-align: center;
}

.ef-blog-kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 0 .45rem;
  border-radius: 0;
  color: #0a304c;
  background: transparent;
  border: 0;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
  margin-bottom: .9rem;
  position: relative;
}

.ef-blog-kicker::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34px;
  height: 2px;
  transform: translateX(-50%);
  background: #c4a962;
}

h1 {
  margin: 0;
  color: #0a304c;
  font-size: clamp(1.55rem, 3vw, 2.35rem);
  line-height: 1.14;
  font-weight: 900;
  letter-spacing: 0;
}

.ef-blog-subtitle {
  max-width: 680px;
  margin: .9rem auto 0;
  color: #425569;
  font-size: clamp(.9rem, 1.35vw, 1rem);
  line-height: 1.7;
  font-weight: 500;
}
</style>
