---
import { getBlogPermalink } from '~/utils/permalinks';
---

<div class="ef-back-blog">
  <a href={getBlogPermalink()}>Quay lại bài viết</a>
</div>

<style>
  .ef-back-blog {
    max-width: 860px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .ef-back-blog a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.58rem 0.95rem;
    border-radius: 999px;
    color: #0a304c;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(10, 48, 76, 0.12);
    font-size: 0.84rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(10, 48, 76, 0.06);
  }

  .ef-back-blog a::before {
    content: '<';
    margin-right: 0.45rem;
    color: #c4a962;
    font-weight: 900;
  }
</style>
