---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="ef-grid-post">
  {
    image && (
      <a class="ef-grid-post-media" href={link || '#'} aria-label={post.title}>
        <Image
          src={image}
          class="ef-grid-post-image"
          widths={[400, 900]}
          width={900}
          height={506}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post.title}
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }

  <h3>{link ? <a href={link}>{post.title}</a> : post.title}</h3>
  {post.excerpt && <p>{post.excerpt}</p>}
</article>

<style>
  .ef-grid-post {
    min-width: 0;
    padding: 0.85rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(10, 48, 76, 0.08);
    box-shadow: 0 14px 34px rgba(10, 48, 76, 0.07);
  }

  .ef-grid-post-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    margin-bottom: 0.85rem;
    background: rgba(10, 48, 76, 0.06);
  }

  :global(.ef-grid-post-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    margin: 0;
    color: #0a304c;
    font-size: 0.98rem;
    line-height: 1.28;
    font-weight: 900;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: #9a7a2e;
  }

  p {
    margin: 0.55rem 0 0;
    color: #425569;
    font-size: 0.82rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
