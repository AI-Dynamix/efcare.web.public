---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = 'ef-tag-list', title = undefined, isCategory = false } = Astro.props;
---

{
  tags && Array.isArray(tags) && (
    <>
      {title !== undefined && <span class="ef-tag-title">{title}</span>}
      <ul class={className}>
        {tags.map((tag) => (
          <li class="ef-tag">
            {!APP_BLOG?.tag?.isEnabled ? (
              tag.title
            ) : (
              <a href={getPermalink(tag.slug, isCategory ? 'category' : 'tag')}>{tag.title}</a>
            )}
          </li>
        ))}
      </ul>
    </>
  )
}

<style>
.ef-tag-title {
  display: inline-block;
  margin-right: .5rem;
  color: #0a304c;
  font-size: .82rem;
  font-weight: 800;
}

:global(.ef-tag-list) {
  display: flex;
  flex-wrap: wrap;
  gap: .45rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ef-tag {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: .24rem .65rem;
  border-radius: 999px;
  background: rgba(8,79,138,.06);
  border: 1px solid rgba(8,79,138,.1);
  color: #0a304c;
  font-size: .76rem;
  font-weight: 800;
  line-height: 1.2;
}

.ef-tag a {
  color: inherit;
  text-decoration: none;
}

.ef-tag:hover {
  background: rgba(196,169,98,.14);
  border-color: rgba(196,169,98,.3);
}
</style>
