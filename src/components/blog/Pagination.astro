---
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Bài mới hơn', nextText = 'Bài cũ hơn' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <div class="ef-blog-pagination">
      <a class={!prevUrl ? 'is-hidden' : ''} href={prevUrl ? getPermalink(prevUrl) : '#'}>
        {prevText}
      </a>
      <a class={!nextUrl ? 'is-hidden' : ''} href={nextUrl ? getPermalink(nextUrl) : '#'}>
        {nextText}
      </a>
    </div>
  )
}

<style>
  .ef-blog-pagination {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 920px;
    margin: 2rem auto 0;
  }

  .ef-blog-pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    color: #0a304c;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(10, 48, 76, 0.12);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(10, 48, 76, 0.06);
  }

  .ef-blog-pagination a:hover {
    border-color: rgba(196, 169, 98, 0.45);
    background: #fff;
  }

  .ef-blog-pagination .is-hidden {
    visibility: hidden;
  }
</style>
