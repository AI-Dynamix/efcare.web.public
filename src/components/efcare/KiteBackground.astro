---
// KiteBackground.astro — 4 CSS kites, diamond shape, parallax scroll
---

<div id="kite-background" aria-hidden="true">
  <div class="kite-css kite-1"></div>
  <div class="kite-css kite-2"></div>
  <div class="kite-css kite-3"></div>
  <div class="kite-css kite-4"></div>
</div>

<style>
#kite-background {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.kite-css {
  position: absolute;
  width: 160px;
  height: 210px;
  opacity: .14;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  filter: blur(.2px);
  will-change: transform;
  mix-blend-mode: multiply;
}

.kite-css::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(145deg, rgba(196,169,98,0.16), rgba(255,255,255,0.02));
  border: 2px solid rgba(196,169,98,0.55);
  box-shadow: 0 0 40px rgba(196,169,98,0.10), inset 0 0 20px rgba(255,255,255,0.08);
  clip-path: polygon(50% 0%, 100% 40%, 50% 100%, 0% 40%);
}

.kite-css::after {
  content: '';
  position: absolute;
  width: 1px;
  height: 90px;
  background: linear-gradient(to bottom, rgba(196,169,98,0.4), transparent);
  left: 50%;
  bottom: -72px;
}

/* Starting positions: bottom of page, drift upward */
.kite-1 { left: 8%;  top: 72%; transform: scale(.9);    animation: kiteDrift1 24s ease-in-out infinite; }
.kite-2 { left: 28%; top: 82%; transform: scale(1.15);  animation: kiteDrift2 30s ease-in-out infinite; }
.kite-3 { right:18%; top: 78%; transform: scale(.82);   animation: kiteDrift3 26s ease-in-out infinite; }
.kite-4 { right: 6%; top: 88%; transform: scale(1.05);  animation: kiteDrift4 34s ease-in-out infinite; }

@media (max-width: 480px) {
  #kite-background { display: none; }
}
</style>

<script>
  // Parallax: sway + float + rotate based on scroll — matches mockup
  (function () {
    const kites = document.querySelectorAll<HTMLElement>('.kite-css');
    let ticking = false;

    function updateParallax() {
      const scrolled = window.pageYOffset;

      kites.forEach((kite, i) => {
        const speed   = 0.12 + i * 0.03;
        const offsetY = scrolled * speed;
        const swayX   = Math.sin(scrolled * 0.001 + i) * 28;
        const rotate  = Math.sin(scrolled * 0.0007 + i) * 10;
        const floatY  = Math.cos(scrolled * 0.0009 + i) * 18;

        kite.style.transform =
          `translate3d(${swayX}px,${-offsetY + floatY}px,0) rotate(${rotate}deg)`;
      });

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });

    updateParallax();
  })();
</script>
