---

<div id="vanta-bg" aria-hidden="true"></div>

<style>
#vanta-bg {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  pointer-events: none;
  opacity: 0.28;
  mix-blend-mode: multiply;
}
</style>

<script>
  function loadScript(src) {
    return new Promise(function(resolve, reject) {
      if (document.querySelector('script[src="' + src + '"]')) { resolve(); return; }
      var s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  var vantaEffect = null;

  function destroyVanta() {
    if (vantaEffect) {
      try { vantaEffect.destroy(); } catch(e) {}
      vantaEffect = null;
    }
  }

  async function initVanta() {
    destroyVanta();
    try {
      await loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js');
      await loadScript('https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.net.min.js');
    } catch(e) { return; }

    var el = document.getElementById('vanta-bg');
    if (!el || !window.VANTA) return;

    vantaEffect = window.VANTA.NET({
      el: el,
      mouseControls: true,
      touchControls: false,
      gyroControls: false,
      minHeight: 200,
      minWidth: 200,
      scale: 1.0,
      scaleMobile: 0.75,
      color: 0xC4A962,
      backgroundColor: 0xf7f7f3,
      points: 10.0,
      maxDistance: 22.0,
      spacing: 16.0,
      showDots: true,
    });
  }

  document.addEventListener('DOMContentLoaded', function() { initVanta(); });
  document.addEventListener('astro:page-load', function() { initVanta(); });
  document.addEventListener('astro:after-swap', function() { destroyVanta(); });
</script>
