---
import { about as aboutData } from '~/data/efcare/about';

interface Props {
  data?: typeof aboutData;
}

const { data = aboutData } = Astro.props;

const statColors = [
  { bg: 'rgba(245,249,255,0.98)', bg2: 'rgba(232,241,252,0.98)', glow: 'rgba(8,79,138,0.12)' },
  { bg: 'rgba(252,250,246,0.98)', bg2: 'rgba(246,240,226,0.98)', glow: 'rgba(196,169,98,0.14)' },
  { bg: 'rgba(246,252,245,0.98)', bg2: 'rgba(233,245,232,0.98)', glow: 'rgba(52,132,98,0.12)' },
  { bg: 'rgba(255,248,244,0.98)', bg2: 'rgba(250,236,228,0.98)', glow: 'rgba(184,96,64,0.12)' },
];
---

<section id="about" class="ef-section about-section">
  <div class="max-container">
    <div class="section-header reveal">
      <span class="section-tag">{data.section.eyebrow}</span>
      <h2 class="section-title">{data.section.heading}</h2>
      <p class="section-subtitle">{data.section.intro}</p>
    </div>

    <!-- Mockup layout: 2-col — left content cards, right stat cards -->
    <div class="about-layout stagger-cards">
      <!-- LEFT: 2 main content cards stacked -->
      <div class="about-left">
        {
          data.mainCards.map((card) => (
            <div class="ef-card about-main-card">
              <h3 class="about-main-title">{card.title}</h3>
              <p class="about-main-body">{card.body}</p>
            </div>
          ))
        }
      </div>

      <!-- RIGHT: 4 stat cards stacked -->
      <div class="about-right">
        {
          data.statCards.map((card, i) => (
            <div
              class="ef-card about-stat-card"
              style={`background: linear-gradient(145deg, ${statColors[i].bg}, ${statColors[i].bg2});`}
            >
              <div
                class="about-stat-glow"
                style={`background: radial-gradient(circle at top right, ${statColors[i].glow}, transparent 30%);`}
              />
              <h4 class="about-stat-title">{card.title}</h4>
              <p class="about-stat-body">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: linear-gradient(180deg, #ffffff 0%, #f6f8f6 100%);
    border-top: 1px solid rgba(10, 48, 76, 0.06);
    border-bottom: 1px solid rgba(10, 48, 76, 0.06);
    padding: clamp(56px, 7vh, 80px) 0 clamp(44px, 5vh, 60px);
  }

  .about-section .section-header {
    margin-bottom: 1.5rem;
  }

  .about-section .section-title {
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  /* 2-column layout */
  .about-layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 24px;
    align-items: stretch;
  }

  /* LEFT: 2 content cards stacked */
  .about-left {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  .about-main-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px 24px;
    background: linear-gradient(135deg, #084F8A 0%, #0A3C4C 100%) !important;
    border: none;
    box-shadow: 0 8px 24px rgba(8,79,138,0.25);
  }

  .about-main-title {
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }

  .about-main-body {
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    color: rgba(255,255,255,0.82);
    line-height: 1.7;
  }

  /* RIGHT: 4 stat cards */
  .about-right {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-content: stretch;
    height: 100%;
  }

  .about-stat-card {
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .about-stat-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .about-stat-title {
    font-size: clamp(0.9rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: var(--ef-navy);
    margin-bottom: 4px;
    letter-spacing: -0.02em;
    position: relative;
    z-index: 1;
  }

  .about-stat-body {
    font-size: clamp(0.8rem, 1.1vw, 0.875rem);
    color: var(--ef-text-muted);
    line-height: 1.55;
    font-weight: 500;
    position: relative;
    z-index: 1;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .about-right {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .about-right {
      grid-template-columns: 1fr;
    }
    .about-main-card {
      min-height: auto;
    }
  }
</style>
