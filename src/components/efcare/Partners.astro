---
import { partners as partnersData } from '~/data/efcare/partners';

interface Props {
  data?: typeof partnersData;
}

const { data = partnersData } = Astro.props;

const svgPaths: Record<string, string> = {
  government: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  hospital: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  building: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  doctor: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  partnership: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<section id="partners" class="ef-section ptn-section">
  <div class="max-container">
    <div class="section-header reveal ptn-header">
      <h2 class="section-title" style="color:#fff;">{data.section.heading}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.68);">{data.section.intro}</p>
    </div>

    <div class="ptn-grid stagger-cards">
      {
        data.cards.map((card, i) => (
          <div class="ptn-card">
            <div class="ptn-icon-hex">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#0A3C4C"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={svgPaths[card.icon] ?? svgPaths.government}
              />
            </div>
            <h4 class="ptn-card-title">{card.title}</h4>
            <p class="ptn-card-body">{card.body}</p>
          </div>
        ))
      }
    </div>

    <div class="ptn-cta reveal">
      <a href={data.cta.href} class="ptn-btn">
        {data.cta.text}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .ptn-section {
    background: radial-gradient(ellipse 70% 90% at 50% 0%, #084F8A 0%, #0A3C4C 50%, #071828 100%);
    border: none;
    padding: clamp(44px, 5vh, 64px) 0;
  }

  .ptn-header {
    margin-bottom: 2rem;
  }

  .ptn-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .ptn-card {
    background: radial-gradient(ellipse 80% 55% at 50% 0%, rgba(8,100,200,0.22) 0%, transparent 70%), linear-gradient(160deg, rgba(10,38,72,0.9) 0%, rgba(5,18,38,0.95) 100%);
    border: 1.5px solid rgba(196,169,98,0.18);
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    backdrop-filter: blur(12px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
    opacity: 0;
    transform: translateY(20px);
    animation: ptnCardIn 0.5s cubic-bezier(0.4,0,0.2,1) forwards;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .ptn-card:nth-child(1) { animation-delay: 0.05s; }
  .ptn-card:nth-child(2) { animation-delay: 0.12s; }
  .ptn-card:nth-child(3) { animation-delay: 0.19s; }
  .ptn-card:nth-child(4) { animation-delay: 0.26s; }
  .ptn-card:nth-child(5) { animation-delay: 0.33s; }

  @keyframes ptnCardIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .ptn-card:hover {
    background: radial-gradient(ellipse 80% 55% at 50% 0%, rgba(8,130,230,0.28) 0%, transparent 70%), linear-gradient(160deg, rgba(8,50,110,0.92) 0%, rgba(8,28,56,0.98) 100%);
    border-color: rgba(228,196,100,0.5);
    transform: translateY(-4px);
    box-shadow: 0 10px 36px rgba(0,0,0,0.4), 0 0 20px rgba(196,169,98,0.10);
  }

  .ptn-icon-hex {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #C4A962;
    border-radius: 14px;
    box-shadow: 0 4px 16px rgba(196,150,42,0.40), inset 0 1px 0 rgba(255,255,255,0.2);
    margin-bottom: 1rem;
  }

  .ptn-icon-hex svg {
    width: 26px;
    height: 26px;
  }

  .ptn-card-title {
    font-size: clamp(0.875rem, 1.2vw, 1rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }

  .ptn-card-body {
    font-size: clamp(0.75rem, 0.95vw, 0.82rem);
    color: rgba(255,255,255,0.58);
    line-height: 1.55;
    margin: 0;
  }

  .ptn-cta {
    text-align: center;
  }

  .ptn-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #C4A962;
    color: #0A3C4C;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.75rem;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(196,150,42,0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease, gap 0.2s ease;
  }

  .ptn-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(196,150,42,0.45);
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .ptn-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 560px) {
    .ptn-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
