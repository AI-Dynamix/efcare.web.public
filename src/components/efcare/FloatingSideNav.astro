---
// FloatingSideNav.astro — Floating right-side navigation
---

<nav class="floating-side-nav" aria-label="Điều hướng nhanh">
  <a href="/" class="side-nav-item" data-section="hero" aria-label="Trang chủ">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span class="tooltip">Trang chủ</span>
  </a>
  <a href="#about" class="side-nav-item" data-section="about" aria-label="Về chúng tôi">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span class="tooltip">Về chúng tôi</span>
  </a>
  <a href="#technology" class="side-nav-item" data-section="technology" aria-label="Công nghệ">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
    <span class="tooltip">Công nghệ</span>
  </a>
  <a href="#app" class="side-nav-item" data-section="app" aria-label="App EFCARE">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
    <span class="tooltip">App EFCARE</span>
  </a>
  <a href="#values" class="side-nav-item" data-section="values" aria-label="Triết lý">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    <span class="tooltip">Triết lý</span>
  </a>
  <a href="/bai-viet" class="side-nav-item" data-section="bai-viet" aria-label="Bài viết">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    <span class="tooltip">Bài viết</span>
  </a>
  <a href="#partners" class="side-nav-item" data-section="partners" aria-label="Đối tác">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <span class="tooltip">Đối tác</span>
  </a>
  <a href="/lien-he" class="side-nav-item" data-section="contact" aria-label="Liên hệ">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span class="tooltip">Liên hệ</span>
  </a>
</nav>

<script>
  // Highlight active section in floating side nav
  (function () {
    const sections = ['hero', 'about', 'technology', 'app', 'values', 'partners'];
    const navItems = document.querySelectorAll<HTMLElement>('.side-nav-item[data-section]');

    function getActiveSection() {
      const scrollPos = window.scrollY + window.innerHeight / 3;
      let active = 'hero';
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el && el.offsetTop <= scrollPos) active = id;
      }
      return active;
    }

    function updateNav() {
      const active = getActiveSection();
      navItems.forEach((item) => {
        const section = item.getAttribute('data-section');
        item.classList.toggle('active', section === active);
      });
    }

    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();
  })();
</script>
