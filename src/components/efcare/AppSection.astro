---
// AppSection.astro — "Ứng dụng sức khỏe cho cả gia đình"
---

<section id="app" class="ef-section ef-section-ivory">
  <div class="max-container">
    <div class="hero-grid" style="gap:3rem;">
      <!-- Left: Content -->
      <div class="reveal">
        <span class="section-tag">Ứng dụng</span>
        <h2 class="section-title" style="margin-top:0.75rem;">
          Ứng dụng sức khỏe<br />cho cả gia đình
        </h2>
        <p style="color:#4a5568;line-height:1.7;margin-bottom:1.5rem;font-size:1.0625rem;">
          App EFCARE là người bạn đồng hành sức khỏe đáng tin cậy, giúp bạn quản lý sức khỏe cá nhân và theo dõi toàn bộ
          thành viên gia đình mọi lúc, mọi nơi.
        </p>

        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;">
          <span
            class="app-feature-tag"
            style="background:rgba(10,48,76,0.08);border-color:rgba(10,48,76,0.2);color:var(--navy);"
          >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            AI Health Assistant
          </span>
          <span
            class="app-feature-tag"
            style="background:rgba(10,48,76,0.08);border-color:rgba(10,48,76,0.2);color:var(--navy);"
          >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Telemedicine
          </span>
          <span
            class="app-feature-tag"
            style="background:rgba(10,48,76,0.08);border-color:rgba(10,48,76,0.2);color:var(--navy);"
          >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Family Health
          </span>
          <span
            class="app-feature-tag"
            style="background:rgba(10,48,76,0.08);border-color:rgba(10,48,76,0.2);color:var(--navy);"
          >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            IoT Device
          </span>
        </div>

        <div class="app-features-grid">
          <!-- Feature 1 -->
          <div class="app-feature-item">
            <div class="app-feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline
                  points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line
                  x1="16"
                  y1="17"
                  x2="8"
                  y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg
              >
            </div>
            <div>
              <h4
                style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--navy);font-size:0.9375rem;margin-bottom:0.25rem;"
              >
                Hồ sơ sức khỏe số
              </h4>
              <p style="color:#4a5568;font-size:0.875rem;line-height:1.5;">
                Lưu trữ toàn bộ lịch sử khám chữa bệnh, xét nghiệm, đơn thuốc và chỉ số sinh hiệu của cả gia đình trong
                một nơi duy nhất.
              </p>
            </div>
          </div>
          <!-- Feature 2 -->
          <div class="app-feature-item">
            <div class="app-feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
            </div>
            <div>
              <h4
                style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--navy);font-size:0.9375rem;margin-bottom:0.25rem;"
              >
                Bác sĩ trực tuyến
              </h4>
              <p style="color:#4a5568;font-size:0.875rem;line-height:1.5;">
                Kết nối trực tiếp với đội ngũ bác sĩ chuyên khoa qua video call, chat, hoặc đặt lịch khám tại cơ sở y tế
                uy tín.
              </p>
            </div>
          </div>
          <!-- Feature 3 -->
          <div class="app-feature-item">
            <div class="app-feature-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path
                  d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
              >
            </div>
            <div>
              <h4
                style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--navy);font-size:0.9375rem;margin-bottom:0.25rem;"
              >
                Theo dõi người thân
              </h4>
              <p style="color:#4a5568;font-size:0.875rem;line-height:1.5;">
                Giám sát sức khỏe cha mẹ, con cái và người thân từ xa, nhận thông báo kịp thời khi có bất thường về chỉ
                số sinh hiệu.
              </p>
            </div>
          </div>
        </div>

        <div style="margin-top:1.5rem;">
          <a href="/lien-he" class="btn-primary-ef"> Tải App EFCARE ngay </a>
        </div>
      </div>

      <!-- Right: Phone mockup -->
      <div class="reveal" style="display:flex;justify-content:center;align-items:center;transition-delay:0.15s;">
        <div style="position:relative;max-width:320px;">
          <img
            src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
            alt="App EFCARE - Ứng dụng chăm sóc sức khỏe gia đình"
            class="phone-mockup"
            loading="lazy"
            width="300"
            height="500"
          />
          <div
            style="position:absolute;top:-1rem;right:-1rem;background:var(--gold);color:var(--navy);border-radius:0.75rem;padding:0.75rem 1rem;font-size:0.8125rem;font-weight:700;font-family:'Montserrat',sans-serif;box-shadow:0 4px 15px rgba(196,169,98,0.4);"
          >
            AI-Powered<br />Healthcare
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
