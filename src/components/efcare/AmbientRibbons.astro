---
interface Props {
  variant?: 'light' | 'deep';
}

const { variant = 'light' } = Astro.props;
---

<div class={`ef-ambient-logos ${variant}`} aria-hidden="true">
  <img src="/logo-icon.svg" class="ambient-logo logo-1" alt="" />
  <img src="/logo-icon.svg" class="ambient-logo logo-2" alt="" />
  <img src="/logo-icon.svg" class="ambient-logo logo-3" alt="" />
</div>

<style>
  .ef-ambient-logos {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: paint;
  }

  .ambient-logo {
    position: absolute;
    opacity: 0.12;
    filter: brightness(10) saturate(0);
    will-change: transform;
    user-select: none;
  }

  .logo-1 {
    width: clamp(260px, 28vw, 420px);
    top: -8%;
    left: -6%;
    animation: logoDrift1 14s ease-in-out infinite alternate;
  }

  .logo-2 {
    width: clamp(180px, 20vw, 300px);
    bottom: -10%;
    right: -4%;
    opacity: 0.08;
    animation: logoDrift2 18s ease-in-out infinite alternate;
  }

  .logo-3 {
    width: clamp(120px, 14vw, 200px);
    top: 38%;
    right: 28%;
    opacity: 0.06;
    animation: logoDrift3 12s ease-in-out infinite alternate;
  }

  /* deep variant — used on dark sections */
  .ef-ambient-logos.deep .ambient-logo {
    filter: brightness(10) saturate(0);
    opacity: 0.10;
  }

  @keyframes logoDrift1 {
    from { transform: translate3d(0, 0, 0) rotate(-8deg) scale(1); }
    to   { transform: translate3d(4%, 3%, 0) rotate(-2deg) scale(1.06); }
  }

  @keyframes logoDrift2 {
    from { transform: translate3d(0, 0, 0) rotate(10deg) scale(1); }
    to   { transform: translate3d(-3%, -4%, 0) rotate(4deg) scale(1.08); }
  }

  @keyframes logoDrift3 {
    from { transform: translate3d(0, 0, 0) rotate(3deg) scale(1); }
    to   { transform: translate3d(-5%, 6%, 0) rotate(-4deg) scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-logo { animation: none; }
  }

  @media (max-width: 640px) {
    .logo-1 { width: 200px; }
    .logo-2 { width: 140px; }
    .logo-3 { display: none; }
  }
</style>
