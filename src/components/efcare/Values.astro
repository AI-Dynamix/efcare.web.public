---
import { values as valuesData } from '~/data/efcare/values';

interface Props {
  data?: typeof valuesData;
}

const { data = valuesData } = Astro.props;
---

<section id="values" class="ef-section ef-section-values">
  <div class="max-container">
    <div class="section-header reveal">
      <span class="section-tag">{data.section.eyebrow}</span>
      <h2 class="section-title">{data.section.heading}</h2>
      <p class="section-subtitle">{data.section.intro}</p>
    </div>

    <div class="values-grid stagger-cards">
      {data.cards.map((card) => (
        <div class="value-card" style={`background:${card.gradient};`}>
          <div class="value-card-bg-symbol">{card.symbol}</div>
          <div class="value-card-number">{card.number}</div>
          <div class="value-card-title">{card.title}</div>
          <div class="value-card-desc">{card.body}</div>
        </div>
      ))}
    </div>
  </div>
</section>
