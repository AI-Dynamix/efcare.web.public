---
// Contact.astro — "Liên hệ cùng chúng tôi" section
---

<section id="contact" class="ef-section ef-section-glass" style="background:linear-gradient(135deg,#0A304C 0%,#071f33 100%);">
  <div class="max-container">
    <div class="section-header reveal">
      <span class="section-tag">Liên hệ</span>
      <h2 class="section-title dark">Liên hệ cùng chúng tôi</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.7);">
        Chúng tôi luôn sẵn sàng hỗ trợ bạn. Hãy liên hệ để bắt đầu hành trình chăm sóc sức khỏe cùng EFCARE.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Info Cards -->
      <div class="contact-info-cards reveal">
        <!-- Address -->
        <div class="glass-card" style="padding:1.5rem;">
          <div style="display:flex;align-items:flex-start;gap:1rem;">
            <div class="card-icon-outline" style="flex-shrink:0;margin-bottom:0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h4 style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--gold);font-size:0.9375rem;margin-bottom:0.375rem;">Địa chỉ</h4>
              <p style="color:rgba(255,255,255,0.75);font-size:0.9rem;line-height:1.6;">
                Tầng 6, số 10, ngõ 45 Trần Thái Thông<br/>
                Phường Cầu Giấy, Hà Nội
              </p>
            </div>
          </div>
        </div>

        <!-- Phone -->
        <div class="glass-card" style="padding:1.5rem;">
          <div style="display:flex;align-items:flex-start;gap:1rem;">
            <div class="card-icon-outline" style="flex-shrink:0;margin-bottom:0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h4 style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--gold);font-size:0.9375rem;margin-bottom:0.375rem;">Điện thoại</h4>
              <p style="color:rgba(255,255,255,0.75);font-size:0.9rem;line-height:1.6;">
                <a href="tel:0815515456" style="color:var(--gold-soft);text-decoration:none;font-weight:600;">0815 515 456</a><br/>
                <span style="color:rgba(255,255,255,0.5);font-size:0.8125rem;">Thứ 2 — Chủ nhật, 8:00 — 20:00</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div class="glass-card" style="padding:1.5rem;">
          <div style="display:flex;align-items:flex-start;gap:1rem;">
            <div class="card-icon-outline" style="flex-shrink:0;margin-bottom:0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h4 style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--gold);font-size:0.9375rem;margin-bottom:0.375rem;">Email</h4>
              <p style="color:rgba(255,255,255,0.75);font-size:0.9rem;line-height:1.6;">
                <a href="mailto:hello@efcare.vn" style="color:var(--gold-soft);text-decoration:none;">hello@efcare.vn</a><br/>
                <a href="mailto:business@efcare.vn" style="color:var(--gold-soft);text-decoration:none;">business@efcare.vn</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form reveal" style="transition-delay:0.15s;">
        <h3 style="font-family:'Montserrat',sans-serif;font-weight:700;color:var(--white);font-size:1.125rem;margin-bottom:1.5rem;">Gửi tin nhắn cho chúng tôi</h3>
        <form action="mailto:hello@efcare.vn" method="get" novalidate>
          <div class="form-group">
            <label class="form-label" for="contact-name">Họ và tên *</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              class="form-input"
              placeholder="Nguyễn Văn A"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-phone">Số điện thoại</label>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              class="form-input"
              placeholder="0912 345 678"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email *</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              class="form-input"
              placeholder="email@example.com"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-message">Nội dung *</label>
            <textarea
              id="contact-message"
              name="message"
              class="form-textarea"
              placeholder="Hãy cho chúng tôi biết chúng tôi có thể giúp gì cho bạn..."
              required
            ></textarea>
          </div>
          <button type="submit" class="btn-primary-ef" style="width:100%;justify-content:center;border:none;cursor:pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Gửi tin nhắn
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
