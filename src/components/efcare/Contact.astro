---
import { site } from '~/data/efcare/site';

interface Props {
  data?: typeof site;
}

const { data = site } = Astro.props;
---

<section id="contact" class="ef-section ef-section-ivory">
  <div class="max-container">
    <div class="section-header reveal">
      <span class="section-tag">Liên hệ</span>
      <h2 class="section-title">Liên hệ cùng chúng tôi</h2>
      <p class="section-subtitle">
        Chúng tôi luôn sẵn sàng hỗ trợ bạn. Hãy liên hệ để bắt đầu hành trình chăm sóc sức khỏe cùng EFCARE.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Info Cards -->
      <div class="contact-info-cards reveal">
        <div class="glass-card contact-info-card">
          <div style="display:flex;align-items:flex-start;gap:1rem;">
            <div class="card-icon-outline" style="flex-shrink:0;margin-bottom:0;">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"
                ></circle></svg
              >
            </div>
            <div>
              <h4 class="contact-info-label">Địa chỉ</h4>
              <p class="contact-info-text">{data.address.street}<br />{data.address.ward}, {data.address.city}</p>
            </div>
          </div>
        </div>

        <div class="glass-card contact-info-card">
          <div style="display:flex;align-items:flex-start;gap:1rem;">
            <div class="card-icon-outline" style="flex-shrink:0;margin-bottom:0;">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
            </div>
            <div>
              <h4 class="contact-info-label">Điện thoại</h4>
              <p class="contact-info-text">
                <a href={data.hotlineTel} class="contact-link-gold">{data.hotline}</a><br />
                <span class="contact-info-sub">{data.workingHours}</span>
              </p>
            </div>
          </div>
        </div>

        <div class="glass-card contact-info-card">
          <div style="display:flex;align-items:flex-start;gap:1rem;">
            <div class="card-icon-outline" style="flex-shrink:0;margin-bottom:0;">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline
                  points="22,6 12,13 2,6"></polyline></svg
              >
            </div>
            <div>
              <h4 class="contact-info-label">Email</h4>
              <p class="contact-info-text">
                <a href={`mailto:${data.email}`} class="contact-link-gold">{data.email}</a><br />
                <a href={`mailto:${data.emailBusiness}`} class="contact-link-gold">{data.emailBusiness}</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form reveal" style="transition-delay:0.15s;">
        <h3 class="contact-form-title">Gửi tin nhắn cho chúng tôi</h3>
        <form action={`mailto:${data.email}`} method="get" novalidate>
          <div class="form-group">
            <label class="form-label" for="contact-name">Họ và tên *</label>
            <input type="text" id="contact-name" name="name" class="form-input" placeholder="Nguyễn Văn A" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-phone">Số điện thoại</label>
            <input type="tel" id="contact-phone" name="phone" class="form-input" placeholder="0912 345 678" />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email *</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              class="form-input"
              placeholder="email@example.com"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-message">Nội dung *</label>
            <textarea
              id="contact-message"
              name="message"
              class="form-textarea"
              placeholder="Hãy cho chúng tôi biết chúng tôi có thể giúp gì cho bạn..."
              required></textarea>
          </div>
          <button type="submit" class="btn-primary-ef contact-submit-btn">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
            >
            Gửi tin nhắn
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
