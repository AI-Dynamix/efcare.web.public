---
import { technology as techData } from '~/data/efcare/technology';

interface Props {
  data?: typeof techData;
}

const { data = techData } = Astro.props;

const icons: Record<string, string> = {
  cloud: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  ai: '<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>',
  hub: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  esg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<section id="technology" class="ef-section tech-section">
  <div class="max-container">
    <div class="section-header reveal tech-header">
      <h2 class="section-title" style="color:#fff;">{data.section.heading}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.72);">{data.section.intro}</p>
    </div>

    <div class="tech-grid stagger-cards">
      {
        data.cards.map((card) => (
          <div class="tech-card">
            <div class="tech-icon-wrap">
              <div class="tech-icon-hex">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[card.icon] ?? icons.cloud}
                />
              </div>
            </div>
            <div class="tech-card-content">
              <h3 class="tech-card-title">{card.title}</h3>
              <p class="tech-card-body">{card.body}</p>
            </div>
            <a href="/cong-nghe" class="tech-card-link">
              Tìm hiểu thêm
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech-section {
    background: linear-gradient(135deg, #051e2e 0%, #0A3C4C 40%, #084F8A 100%);
    border: none;
  }

  .tech-header {
    margin-bottom: 2.5rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .tech-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(196,169,98,0.2);
    border-radius: 16px;
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: background 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .tech-card:hover {
    background: rgba(255,255,255,0.10);
    border-color: rgba(196,169,98,0.45);
    transform: translateY(-4px);
  }

  /* Icon — centered, blockchain-style hexagon */
  .tech-icon-wrap {
    margin-bottom: 1.25rem;
  }

  .tech-icon-hex {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(196,169,98,0.25), rgba(196,169,98,0.08));
    border: 1.5px solid rgba(196,169,98,0.5);
    border-radius: 14px;
    position: relative;
    box-shadow: 0 0 20px rgba(196,169,98,0.15), inset 0 0 12px rgba(255,255,255,0.04);
  }

  .tech-icon-hex::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 15px;
    background: linear-gradient(135deg, rgba(196,169,98,0.4), transparent 60%);
    z-index: 0;
    pointer-events: none;
  }

  .tech-icon-hex svg {
    width: 28px;
    height: 28px;
    stroke: #C4A962;
    position: relative;
    z-index: 1;
  }

  /* Content — grows to fill space */
  .tech-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tech-card-title {
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin: 0;
  }

  .tech-card-body {
    font-size: clamp(0.8rem, 1vw, 0.875rem);
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    margin: 0;
  }

  /* Link — always at bottom */
  .tech-card-link {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #C4A962;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .tech-card-link:hover {
    color: #e8d89a;
    gap: 0.65rem;
  }

  @media (max-width: 900px) {
    .tech-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
