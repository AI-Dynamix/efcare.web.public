---
import { technology as techData } from '~/data/efcare/technology';

interface Props {
  data?: typeof techData;
}

const { data = techData } = Astro.props;

const icons: Record<string, string> = {
  cloud: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  ai: '<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>',
  hub: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  esg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<section id="technology" class="ef-section ef-section-dark">
  <div class="max-container">
    <div class="section-header reveal">
      <span class="section-tag">{data.section.eyebrow}</span>
      <h2 class="section-title dark">{data.section.heading}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.7);">{data.section.intro}</p>
    </div>

    <div class="services-grid-4 stagger-cards">
      {data.cards.map((card) => (
        <div class="glass-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[card.icon] ?? icons.cloud} />
          </div>
          <h3 class="tech-card-title">{card.title}</h3>
          <p class="tech-card-body">{card.body}</p>
          <a href="/cong-nghe" class="card-link">Tìm hiểu thêm →</a>
        </div>
      ))}
    </div>
  </div>
</section>
