---
import { technology as techData } from '~/data/efcare/technology';

interface Props {
  data?: typeof techData;
}

const { data = techData } = Astro.props;

const icons: Record<string, string> = {
  cloud: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  ai: '<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>',
  hub: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  esg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<section id="technology" class="ef-section tech-section">
  <div class="max-container">
    <div class="section-header reveal tech-header">
      <h2 class="section-title" style="color:#fff;">{data.section.heading}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.72);">{data.section.intro}</p>
    </div>

    <div class="tech-grid stagger-cards">
      {
        data.cards.map((card) => (
          <div class="tech-card">
            <div class="tech-icon-wrap">
              <div class="tech-icon-hex">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[card.icon] ?? icons.cloud}
                />
              </div>
            </div>
            <div class="tech-card-content">
              <h3 class="tech-card-title">{card.title}</h3>
              <p class="tech-card-body">{card.body}</p>
            </div>
            <a href="/cong-nghe" class="tech-card-link">
              Tìm hiểu thêm
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech-section {
    background: radial-gradient(ellipse 70% 90% at 50% 0%, #084F8A 0%, #0A3C4C 50%, #071828 100%);
    border: none;
  }

  .tech-header {
    margin-bottom: 2.5rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .tech-card {
    background: linear-gradient(160deg, rgba(8,30,58,0.85) 0%, rgba(5,18,38,0.92) 100%);
    border: 1.5px solid rgba(196,169,98,0.18);
    border-radius: 16px;
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    opacity: 0;
    transform: translateY(24px);
    animation: techCardIn 0.55s cubic-bezier(0.4,0,0.2,1) forwards;
  }

  .tech-card:nth-child(1) { animation-delay: 0.05s; }
  .tech-card:nth-child(2) { animation-delay: 0.15s; }
  .tech-card:nth-child(3) { animation-delay: 0.25s; }
  .tech-card:nth-child(4) { animation-delay: 0.35s; }

  @keyframes techCardIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .tech-card:hover {
    background: linear-gradient(160deg, rgba(8,50,100,0.9) 0%, rgba(8,30,58,0.95) 100%);
    border-color: rgba(228,196,100,0.55);
    transform: translateY(-5px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.45), 0 0 24px rgba(196,169,98,0.12);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
  }

  /* Icon — blockchain-style */
  .tech-icon-wrap {
    margin-bottom: 1.25rem;
  }

  .tech-icon-hex {
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(228,196,100,0.18), rgba(196,169,98,0.06));
    border: 2px solid #D4A820;
    border-radius: 14px;
    position: relative;
    box-shadow: 0 0 16px rgba(212,168,32,0.30), 0 0 40px rgba(212,168,32,0.10), inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .tech-icon-hex::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 50%;
    border-radius: 14px 14px 0 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.07), transparent);
    pointer-events: none;
  }

  .tech-icon-hex svg {
    width: 30px;
    height: 30px;
    stroke: #E8C840;
    stroke-width: 1.8;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 6px rgba(232,200,64,0.5));
  }

  /* Content — grows to fill space */
  .tech-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tech-card-title {
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin: 0;
  }

  .tech-card-body {
    font-size: clamp(0.8rem, 1vw, 0.875rem);
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    margin: 0;
  }

  /* Link — always at bottom */
  .tech-card-link {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #C4A962;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .tech-card-link:hover {
    color: #e8d89a;
    gap: 0.65rem;
  }

  @media (max-width: 900px) {
    .tech-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
