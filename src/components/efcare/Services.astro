---
import { services as servicesData } from '~/data/efcare/services';

interface Props {
  data?: typeof servicesData;
}

const { data = servicesData } = Astro.props;

const icons: Record<string, string> = {
  hub: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>',
  app: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
  community: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
  esg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<section id="services" class="ef-section ef-section-dark">
  <div class="max-container">
    <div class="section-header reveal">
      <span class="section-tag">{data.section.eyebrow}</span>
      <h2 class="section-title dark">{data.section.heading}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.7);">{data.section.intro}</p>
    </div>

    <div class="services-grid stagger-cards">
      {data.cards.map((card) => (
        <div class="glass-card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[card.icon] ?? icons.hub} />
          </div>
          <h3 class="service-card-title">{card.title}</h3>
          <p class="service-card-body">{card.body}</p>
          <ul class="card-list">
            {card.list.map((item) => (
              <li style="color:rgba(255,255,255,0.7);">{item}</li>
            ))}
          </ul>
          <a href={card.cta.href} class="card-link">{card.cta.text}</a>
        </div>
      ))}
    </div>
  </div>
</section>
