---
import { services as servicesData } from '~/data/efcare/services';

interface Props {
  data?: typeof servicesData;
}

const { data = servicesData } = Astro.props;

const icons: Record<string, string> = {
  hub: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>',
  app: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
  community: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
  esg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
};
---

<section id="services" class="ef-section svc-section">
  <div class="max-container">
    <div class="section-header reveal svc-header">
      <h2 class="section-title" style="color:#fff;">{data.section.heading}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,0.68);">{data.section.intro}</p>
    </div>

    <div class="svc-grid stagger-cards">
      {
        data.cards.map((card, i) => (
          <div class="svc-card">
            <div class="svc-card-top">
              <div class="svc-icon-hex">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[card.icon] ?? icons.hub}
                />
              </div>
              <h3 class="svc-card-title">{card.title}</h3>
            </div>
            <div class="svc-card-content">
              <p class="svc-card-body">{card.body}</p>
              <ul class="svc-list">
                {card.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <a href={card.cta.href} class="svc-card-link">
              {card.cta.text}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc-section {
    background: radial-gradient(ellipse 70% 90% at 50% 0%, #084F8A 0%, #0A3C4C 50%, #071828 100%);
    border: none;
    padding: clamp(44px, 5vh, 60px) 0;
  }

  .svc-header {
    margin-bottom: 1.75rem;
  }

  .svc-header .section-subtitle {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .svc-card {
    background: radial-gradient(ellipse 80% 55% at 50% 0%, rgba(8,100,200,0.22) 0%, transparent 70%), linear-gradient(160deg, rgba(10,38,72,0.9) 0%, rgba(5,18,38,0.95) 100%);
    border: 1.5px solid rgba(196,169,98,0.18);
    border-radius: 14px;
    padding: 1.25rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(12px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    opacity: 0;
    transform: translateY(20px);
    animation: svcCardIn 0.5s cubic-bezier(0.4,0,0.2,1) forwards;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .svc-card:nth-child(1) { animation-delay: 0.05s; }
  .svc-card:nth-child(2) { animation-delay: 0.15s; }
  .svc-card:nth-child(3) { animation-delay: 0.25s; }
  .svc-card:nth-child(4) { animation-delay: 0.35s; }

  @keyframes svcCardIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .svc-card:hover {
    background: radial-gradient(ellipse 80% 55% at 50% 0%, rgba(8,130,230,0.28) 0%, transparent 70%), linear-gradient(160deg, rgba(8,50,110,0.92) 0%, rgba(8,28,56,0.98) 100%);
    border-color: rgba(228,196,100,0.5);
    transform: translateY(-4px);
    box-shadow: 0 10px 36px rgba(0,0,0,0.45), 0 0 20px rgba(196,169,98,0.10);
  }

  .svc-card-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .svc-icon-hex {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #C4A962;
    border: none;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(196,150,42,0.45), inset 0 1px 0 rgba(255,255,255,0.2);
    position: relative;
  }

  .svc-icon-hex svg {
    width: 24px;
    height: 24px;
    stroke: #0A3C4C;
    stroke-width: 2;
    filter: none;
  }

  .svc-card-title {
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .svc-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .svc-card-body {
    font-size: clamp(0.78rem, 1vw, 0.85rem);
    color: rgba(255,255,255,0.62);
    line-height: 1.55;
    margin: 0;
  }

  .svc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem 0.5rem;
  }

  .svc-list li {
    font-size: clamp(0.75rem, 0.95vw, 0.82rem);
    color: rgba(255,255,255,0.55);
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }

  .svc-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #C4A962;
    opacity: 0.7;
  }

  .svc-card-link {
    margin-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #C4A962;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .svc-card-link:hover {
    color: #C4A962;
    gap: 0.6rem;
  }

  @media (max-width: 640px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
