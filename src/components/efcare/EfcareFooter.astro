---
import { site } from '~/data/efcare/site';
import { footer as footerData } from '~/data/efcare/navigation';

interface Props {
  siteData?: typeof site;
  footerData?: typeof footerData;
}

const { siteData = site, footerData: columns = footerData } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="ef-footer">
  <div class="footer-grid">
    <!-- Brand Column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="EFCARE Trang chủ">
        <img src="/logo-icon.svg" alt="" width="32" height="32" />
        <img src="/logo-text.svg" alt="EFCARE" width="108" height="32" />
      </a>
      <p class="footer-tagline">{siteData.tagline}</p>
      <p class="footer-desc">
        Hệ sinh thái chăm sóc sức khỏe gia đình đa thế hệ, kết nối công nghệ, y tế và cộng đồng.
      </p>
      <p class="footer-address">{siteData.address.street}<br/>{siteData.address.ward}, {siteData.address.city}</p>
      <div class="footer-social" style="margin-top:1.25rem;">
        <a href={siteData.socials.facebook} class="social-link" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href={siteData.socials.youtube} class="social-link" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96C1 8.14 1 12 1 12s0 3.86.46 5.58a2.78 2.78 0 0 0 1.95 1.97C5.12 20 12 20 12 20s6.88 0 8.59-.45a2.78 2.78 0 0 0 1.95-1.97C23 15.86 23 12 23 12s0-3.86-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={siteData.socials.linkedin} class="social-link" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href={siteData.socials.instagram} class="social-link" aria-label="Zalo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </a>
      </div>
    </div>

    <!-- Link Columns -->
    {columns.columns.map((col) => (
      <div class="footer-col">
        <h4>{col.heading}</h4>
        <ul>
          {col.links.map((link) => (
            <li><a href={link.href}>{link.text}</a></li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Contact Column -->
    <div class="footer-col">
      <h4>Liên hệ</h4>
      <ul>
        <li>
          <a href={siteData.hotlineTel} class="footer-contact-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.62 4.38A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {siteData.hotline}
          </a>
        </li>
        <li>
          <a href={`mailto:${siteData.email}`} class="footer-contact-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            {siteData.email}
          </a>
        </li>
        <li>
          <a href={`mailto:${siteData.emailBusiness}`} class="footer-contact-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            {siteData.emailBusiness}
          </a>
        </li>
        <li>
          <a href="/lien-he" class="footer-contact-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Gửi tin nhắn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="footer-copy">
      &copy; {currentYear} {siteData.name} — {siteData.legalName}. Bảo lưu mọi quyền.
    </p>
    <div class="footer-bottom-links">
      <a href="/privacy">Chính sách bảo mật</a>
      <a href="/terms">Điều khoản sử dụng</a>
    </div>
  </div>
</footer>
