---
import { hero as heroData } from '~/data/efcare/hero';

interface Props {
  data?: typeof heroData;
}

const { data = heroData } = Astro.props;
---

<section id="hero" class="ef-hero">
  <div class="hero-grid">
    <!-- Left: Content -->
    <div class="hero-content reveal">
      <div class="hero-eyebrow">{data.eyebrow}</div>
      <h1 class="hero-h1">
        {data.heading}<br />
        <span class="accent">{data.headingAccent}</span>
      </h1>
      <p class="hero-p">{data.description}</p>

      <div class="feature-row">
        {data.features.map((f) => (
          <span class="feature-tag">{f}</span>
        ))}
      </div>

      <div class="btn-group">
        <a href={data.ctaPrimary.href} class="btn-primary-ef">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          {data.ctaPrimary.text}
        </a>
        <a href={data.ctaSecondary.href} class="btn-outline-ef">
          {data.ctaSecondary.text}
        </a>
      </div>
    </div>

    <!-- Right: Image -->
    <div class="hero-image-wrapper reveal" style="transition-delay:0.2s">
      <picture>
        <source srcset="/images/hero.webp" type="image/webp" />
        <img
          src="/images/hero.webp"
          alt={data.image.alt}
          class="hero-img"
          loading="eager"
          decoding="async"
          width="1402"
          height="1122"
        />
      </picture>
      <div class="floating-card">
        <div class="floating-card-label">{data.floatingCard.label}</div>
        <div class="floating-card-tagline">{data.floatingCard.text}</div>
      </div>
    </div>
  </div>
</section>
