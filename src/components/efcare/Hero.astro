---
import { heroSlides } from '~/data/efcare/hero';
import AmbientRibbons from '~/components/efcare/AmbientRibbons.astro';

const slide = heroSlides[0];
const heroImages = [
  { src: '/images/efcare-hero-1.webp', alt: 'EFCARE đồng hành cùng sức khỏe toàn dân' },
  { src: '/images/efcare-hero-2.webp', alt: 'EFCARE chăm sóc sức khỏe tại nhà' },
  { src: '/images/efcare-hero-3.webp', alt: 'EFCARE giải pháp y tế toàn diện' },
];
---

<section id="hero" class="ef-hero">
  <AmbientRibbons />
  <div class="hero-grid">
    <div class="hero-content">
      <div class="hero-logo-lockup" aria-label="EFCARE">
        <span class="hero-logo-icon">
          <img src="/logo-icon.svg" alt="" width="54" height="46" />
        </span>
        <img src="/logo-text.svg" alt="EFCARE" class="hero-logo-text" width="178" height="52" />
      </div>
      <div class="hero-eyebrow">{slide.eyebrow}</div>
      <h1 class="hero-h1">
        {slide.heading}<br />
        <span>{slide.headingAccent}</span>
      </h1>
      <p class="hero-p">{slide.description}</p>

      <div class="btn-group">
        <a href={slide.ctaPrimary.href} class="btn-primary-ef">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
          {slide.ctaPrimary.text}
        </a>
        <a href={slide.ctaSecondary.href} class="btn-outline-ef">
          {slide.ctaSecondary.text}
        </a>
      </div>
    </div>

    <div class="hero-image" id="heroImageSlider" aria-label="Ảnh giới thiệu EFCARE">
      {
        heroImages.map((image, index) => (
          <img
            class={`hero-slide-image${index === 0 ? ' active' : ''}`}
            src={image.src}
            alt={image.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            width="1200"
            height="960"
            data-slide={index}
          />
        ))
      }
      <div class="hero-image-dots" aria-hidden="true">
        {heroImages.map((_, index) => <span class={index === 0 ? 'active' : ''} data-dot={index} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .ef-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at top right, rgba(196, 169, 98, 0.18), transparent 30%),
      radial-gradient(circle at bottom left, rgba(8, 79, 138, 0.08), transparent 28%),
      linear-gradient(180deg, #fdfbf6 0%, #f6efe0 100%);
    border-bottom: 1px solid rgba(196, 169, 98, 0.14);
    padding: clamp(92px, 12vh, 138px) clamp(1rem, 4vw, 2rem) clamp(48px, 8vh, 84px);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(430px, 1.02fr);
    gap: clamp(44px, 6vw, 80px);
    align-items: center;
    width: min(1280px, 100%);
    margin: 0 auto;
  }

  .hero-content {
    max-width: 700px;
  }

  .hero-logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.05rem;
  }

  .hero-logo-icon {
    position: relative;
    display: inline-flex;
    width: 54px;
    height: 46px;
    align-items: center;
    justify-content: center;
  }

  .hero-logo-icon::before {
    content: none;
  }

  .hero-logo-icon img,
  .hero-logo-text {
    position: relative;
    z-index: 1;
    display: block;
  }

  .hero-logo-icon img {
    width: 48px;
    height: auto;
    filter: none;
  }

  .hero-logo-text {
    width: min(178px, 42vw);
    height: auto;
  }

  .hero-eyebrow {
    color: var(--gold, #c4a962);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.82rem;
    margin-bottom: 1.05rem;
  }

  .hero-h1 {
    color: var(--navy, #0a304c);
    font-size: clamp(1.75rem, 2.8vw, 2.55rem);
    line-height: 1.14;
    letter-spacing: 0;
    margin: 0 0 1.25rem;
  }

  .hero-h1 span {
    color: #9a7a2e;
  }

  .hero-p {
    color: #425569;
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.68;
    max-width: 660px;
    margin: 0;
  }

  .btn-group {
    margin-top: 2rem;
  }

  .btn-outline-ef {
    color: var(--navy, #0a304c);
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(10, 48, 76, 0.22);
  }

  .btn-outline-ef:hover {
    color: var(--navy, #0a304c);
    background: #fff;
    border-color: rgba(196, 169, 98, 0.65);
  }

  .hero-image {
    position: relative;
    overflow: visible;
    border-radius: 16px;
    box-shadow: none;
    isolation: isolate;
    aspect-ratio: 5 / 4;
    background: transparent;
    width: 110%;
    justify-self: end;
    margin-bottom: 2rem;
  }

  .hero-image::before {
    content: none;
  }

  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    box-shadow:
      inset 0 0 18px rgba(10, 48, 76, 0.08),
      inset 0 0 34px rgba(255, 255, 255, 0.18);
  }

  .hero-slide-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 0;
    opacity: 0;
    border-radius: inherit;
    filter: none;
    transform: scale(1.04);
    transition:
      opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-slide-image.active {
    opacity: 1;
    transform: scale(1);
    animation: kenBurns 7s ease-in-out forwards;
  }

  @keyframes kenBurns {
    from { transform: scale(1); }
    to   { transform: scale(1.05); }
  }

  .hero-image-dots {
    position: absolute;
    left: 50%;
    bottom: -1.75rem;
    z-index: 2;
    transform: translateX(-50%);
    display: flex;
    gap: 0.45rem;
  }

  .hero-image-dots span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: rgba(10, 48, 76, 0.22);
    transition:
      width 0.25s ease,
      background 0.25s ease;
  }

  .hero-image-dots span.active {
    width: 1.45rem;
    background: var(--gold, #c4a962);
  }

  @media (max-width: 900px) {
    .ef-hero {
      min-height: auto;
      padding-top: 86px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-image {
      width: 100%;
      justify-self: stretch;
    }
  }

  @media (max-width: 560px) {
    .ef-hero {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .hero-h1 {
      font-size: clamp(1.48rem, 6.8vw, 1.9rem);
    }

    .hero-image {
      border-radius: 14px;
    }
  }
</style>

<script>
  (function () {
    const slider = document.getElementById('heroImageSlider');
    if (!slider) return;

    const slides = slider.querySelectorAll('.hero-slide-image');
    const dots = slider.querySelectorAll('.hero-image-dots span');
    let current = 0;
    const total = slides.length;

    if (total <= 1) return;

    function show(index: number) {
      slides[current].classList.remove('active');
      dots[current]?.classList.remove('active');
      current = index % total;
      slides[current].classList.add('active');
      dots[current]?.classList.add('active');
    }

    setInterval(function () {
      show(current + 1);
    }, 6500);
  })();
</script>
